# Adresse du compte PostgreSQL en LECTURE SEULE (bvc_lecture, voir sql/lecture.sql).
# En local : copier ce fichier en .env.local. En ligne : variable d'environnement Vercel.
# Ne jamais y mettre le compte propriétaire, ni versionner une vraie adresse.
DATABASE_URL_LECTURE=postgresql://bvc_lecture:motdepasse@hote/base?sslmode=require
